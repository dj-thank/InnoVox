{
  "name": "innovox",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.19.0 <25" },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "init-local": "node scripts/setup.mjs",
    "diagnose": "node --env-file-if-exists=.env.local dist/src/doctor.js",
    "contracts": "pnpm build && node scripts/export-contracts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "start": "node --env-file-if-exists=.env.local dist/src/main.js",
    "capture": "node --env-file-if-exists=.env.local dist/src/capture.js",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": { "zod": "4.6.5" },
  "devDependencies": { "@types/node": "24.19.0", "typescript": "7.0.2" }
}
