# Never commit .env.local. Configure provider credentials through secure setup.
OPENAI_API_KEY=
INNOVOX_HOST=127.0.0.1
INNOVOX_PORT=4317
INNOVOX_ORIGIN=http://127.0.0.1:4317
INNOVOX_DATABASE=.innovox/state.sqlite
# Required for every deployment. Use a random value of at least 32 characters.
INNOVOX_ACCESS_TOKEN=
# Provider requests are opt-in per project. Limits are local admission limits,
# not a provider billing cap. Voice duration is also limited in the browser.
INNOVOX_MAX_ANALYSES_PER_HOUR=30
INNOVOX_MAX_LIVE_SESSIONS_PER_HOUR=6
