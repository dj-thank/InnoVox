{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "clarify",
        "draft",
        "confirm"
      ]
    },
    "reply": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600
    },
    "answerText": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "intent",
    "reply",
    "answerText"
  ],
  "additionalProperties": false
}
